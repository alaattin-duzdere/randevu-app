
# HOW TO RUN (first time):
#   docker compose up -d --build
#
# HOW TO RUN (subsequent):
#   docker compose up -d
#
# HOW TO STOP:
#   docker compose down

# 1. POSTGRES ADMIN
# Used ONLY by Docker to initialize the PostgreSQL server on first run.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# 2. SPRING BOOT DATASOURCE
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# 3. SECURITY & MAIL
JWT_SECRET_KEY=
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# 4. NETWORK & PORTS
DATABASE_PORT=

BACKEND_PORT=
BACKEND_URL=
FRONTEND_PORT=

# 5. APPLICATION CONFIGURATION
SPRING_PROFILES_ACTIVE=
APP_LOG_LEVEL=
FRONTEND_URL=
NODE_ENV=

# 6. REDIS CONFIGURATION
SPRING_DATA_REDIS_HOST=
SPRING_DATA_REDIS_PORT=

# 7. EXTERNAL APIs
LOCATIONIQ_API_KEY=

# 8. SMS (Macrodroid) - optional
MACRODROID_WEBHOOK_URL=
MACRODROID_WEBHOOK_SECRET=
